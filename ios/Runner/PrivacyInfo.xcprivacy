<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest (CL REL-011). Plugins (Sentry, Razorpay, geolocator,
  secure storage, ...) ship their own manifests; this one covers the app.
  Collected data: what the app sends to the Medibook backend to book and keep
  records (profile, family members, uploads, payments history, approximate
  location for "Hospitals Near You") plus anonymous crash reports. Nothing is
  used for tracking. Keep in step with the App Store privacy answers (REL-016).
  Required-reason APIs: file dates (Hive and the cache, inside the app's own
  container), system boot time (Dart timers measure elapsed time), and
  UserDefaults (plugins' own settings, read only by this app).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
